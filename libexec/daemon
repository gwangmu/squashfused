#!/bin/bash

set -eu
source /usr/local/lib/squashfused/common.sh
source /usr/local/lib/squashfused/path.sh

DAEMON_ID=$1

# Set up logging.
log::file "$SERVER_LOG_DIR_PATH/daemon-$DAEMON_ID.log"
log::echo "squashfused-daemon-$DAEMON_ID"

path::set_host "$DAEMON_ID"

log::echo "owner uid \"$DAEMON_DIR_HOST_PATH\": $(stat "$DAEMON_DIR_HOST_PATH")"

log::echo "$(id)"
while IFS= read -r ARGS <"$BRIDGE_FIFO_HOST_PATH"; do
  log::echo "$ARGS"
  log::echo "squashfuse /home/gwangmu/test_shared/$ARGS \"$BRIDGE_DIR_HOST_PATH\""
  log::echo "$(squashfuse /home/gwangmu/test_shared/$ARGS "$BRIDGE_DIR_HOST_PATH" 2>&1)"
done
