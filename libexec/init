#!/bin/bash

set -eu
source /usr/local/lib/squashfused/common.sh
source /usr/local/lib/squashfused/path.sh

# There is no container ID because, understandably, this is before `create`.
# Instead, use a (pseudo-)hash of the root filesystem path.
state::load
DAEMON_ID=$(cksum <<< $(state::read '.root.path') | cut -d' ' -f1)

# Set up logging.
log::file "$SERVER_LOG_DIR_PATH/init-$DAEMON_ID.log"
log::echo "squashfused-init-$DAEMON_ID"

path::set_host "$DAEMON_ID"

# Start off the delegate daemon.
echo "$DAEMON_ID" >"$SERVER_FIFO_PATH"

while true; do
  if [[ -f "$DAEMON_PID_PATH" ]]; then
    break
  fi
  sleep 0.1
done

# Inject briedges.
state::add '.mounts' '
[{ 
  "source": "'"$BRIDGE_DIR_HOST_PATH"'",
  "type": "bind",
  "destination": "'"$BRIDGE_DIR_CONT_PATH"'",
  "options": [ "rw", "shared", "rbind" ]
}]'

state::add '.mounts' '
[{ 
  "source": "'"$BRIDGE_FIFO_HOST_PATH"'",
  "type": "bind",
  "destination": "'"$BRIDGE_FIFO_CONT_PATH"'",
  "options": [ "rw", "rbind" ]
}]'

# Allow rootfs mount propagation.
state::add '.linux' '{ "rootfsPropagation": "shared" }'

# Inject stub.
state::add '.mounts' '
[{ 
  "source": "/usr/local/libexec/squashfused/stub/squashfuse",
  "type": "bind",
  "destination": "/usr/bin/squashfuse",
  "options": [ "bind" ]
}]'

# DEBUG: log modified OCI runtime spec.
log::echo "$(state::read '.')"

# Print modified OCI runtime spec.
state::print
