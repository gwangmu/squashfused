#!/bin/bash

set -eu
source /usr/local/lib/squashfused/common.sh

log::file "/tmp/squashfused-init.log"
log::echo "squashfused-init"

state::load

# There is no container ID because, understandably, this is before `create`.
# Instead, use a (pseudo-)hash of the root filesystem path.
DAEMON_ID=$(cksum <<< $(state::read '.root.path') | cut -d' ' -f1)

# Start off the delegate daemon.
SQUASHFUSED_SERVER_DIR_PATH="/tmp/squashfused-server"
SQUASHFUSED_SERVER_FIFO_PATH="$SQUASHFUSED_SERVER_DIR_PATH/spawn"
echo "$DAEMON_ID" >"$SQUASHFUSED_SERVER_FIFO_PATH"

SQUASHFUSED_DIR_HOST_PATH="/tmp/squashfused-$DAEMON_ID"
SQUASHFUSED_DIR_CONT_PATH="/squashfused"
BRIDGE_DIR_HOST_PATH="$SQUASHFUSED_DIR_HOST_PATH/bridge_dir"
BRIDGE_DIR_CONT_PATH="$SQUASHFUSED_DIR_CONT_PATH/bridge_dir"
BRIDGE_FIFO_HOST_PATH="$SQUASHFUSED_DIR_HOST_PATH/bridge_fifo"
BRIDGE_FIFO_CONT_PATH="$SQUASHFUSED_DIR_CONT_PATH/bridge_fifo"

# Inject briedges.
# Apparently, this SPECIFIC mount option actually works as a shared bind mount.
state::add '.mounts' '
[{ 
  "source": "'"$BRIDGE_DIR_HOST_PATH"'",
  "type": "bind",
  "destination": "'"$BRIDGE_DIR_CONT_PATH"'",
  "options": [ "rw", "shared", "rbind" ]
}]'

state::add '.mounts' '
[{ 
  "source": "'"$BRIDGE_FIFO_HOST_PATH"'",
  "type": "bind",
  "destination": "'"$BRIDGE_FIFO_CONT_PATH"'",
  "options": [ "rbind", "rw" ]
}]'

# Inject stub.
state::add '.mounts' '
[{ 
  "source": "/usr/local/libexec/squashfused/stub/squashfuse",
  "type": "bind",
  "destination": "/usr/bin/squashfuse",
  "options": [ "bind" ]
}]'

# DEBUG: log modified OCI runtime spec.
log::echo "$(state::read '.')"

# Print modified OCI runtime spec.
state::print
